# Database Connection String
# Defaults to SQLite local file: sqlite:///./cyberguard.db
# For PostgreSQL: postgresql://cyberguard:cyberguard_pass@localhost:5432/cyberguard_db
DATABASE_URL=sqlite:///./cyberguard.db

# JWT Auth Secret
SECRET_KEY=CYBERGUARD_AI_SUPER_SECRET_SECURITY_KEY_2026_PRODUCTION

# Optional LLM API Key (OpenAI / Gemini fallback)
LLM_API_KEY=demo_mode_key

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/soc
